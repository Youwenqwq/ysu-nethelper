#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/ysunethelper
CONF=/etc/ysunethelper/config.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}
